{
  "manifest_version": 3,
  "name": "RetroRevente pour Le Bon Coin et eBay",
  "short_name": "RetroRevente",
  "version": "1.14.1",
  "description": "Remplit le dépôt Le Bon Coin avec ta fiche RetroRevente et t'aide à répondre aux acheteurs sur Le Bon Coin et eBay. Tu publies toi-même.",
  "homepage_url": "https://retrorevente.fr/",
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "96": "icones/icone-96.png",
    "128": "icones/icone-128.png"
  },
  "action": {
    "default_title": "RetroRevente",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/barre-16.png",
      "19": "icones/barre-19.png",
      "32": "icones/barre-32.png",
      "38": "icones/barre-38.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "notifications",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://retrorevente.fr/*",
    "https://www.leboncoin.fr/*",
    "https://*.ebay.fr/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.leboncoin.fr/*"
      ],
      "js": [
        "commun.js",
        "lbc.js",
        "stats.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.ebay.fr/*"
      ],
      "js": [
        "commun.js",
        "ebay.js",
        "stats.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.leboncoin.fr/compte/*",
        "https://www.leboncoin.fr/mes-annonces*",
        "https://www.ebay.fr/sh/*",
        "https://www.ebay.fr/mye/*"
      ],
      "js": [
        "stats-page.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.leboncoin.fr/compte/*",
        "https://www.leboncoin.fr/mes-annonces*",
        "https://www.ebay.fr/sh/*",
        "https://www.ebay.fr/mye/*"
      ],
      "js": [
        "commun.js",
        "stats.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://retrorevente.fr/app/*",
        "http://127.0.0.1/app/*",
        "http://localhost/app/*"
      ],
      "js": [
        "commun.js",
        "appli.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@retrorevente.fr",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "commands": {
    "ouvrir-recherche": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Ouvrir RetroRevente et chercher une annonce (sur Le Bon Coin)"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "polices/*.woff2",
        "icones/icone-128.png"
      ],
      "matches": [
        "https://www.leboncoin.fr/*",
        "https://*.ebay.fr/*"
      ]
    }
  ]
}
