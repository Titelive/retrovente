[Unit]
Description=retrorevente.fr
After=network-online.target
Wants=network-online.target

[Service]
User=titelive
WorkingDirectory=/srv/retrorevente/current
EnvironmentFile=/etc/retrorevente.env
Environment=NODE_ENV=production PORT=8082 DATA_DIR=/var/lib/retrorevente SITE_URL=https://retrorevente.fr NODE_OPTIONS=--no-warnings
ExecStart=/usr/bin/node /srv/retrorevente/current/server/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/retrorevente
MemoryMax=800M

[Install]
WantedBy=multi-user.target
